FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 223.52);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 223.52);
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 223.52);
        value           uniform (0 0 223.52);
    }

    sideWalls
    {
        type            slip;
    }

    propeller
    {
        type            MRFnoSlip;
        value           uniform (0 0 0);
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

