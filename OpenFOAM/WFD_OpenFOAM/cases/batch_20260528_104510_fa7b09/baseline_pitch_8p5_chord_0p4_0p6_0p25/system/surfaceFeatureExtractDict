// OpenFOAM 13 supersedes surfaceFeatureExtract with surfaceFeatures.
// This compatibility dictionary records the equivalent legacy settings;
// the runnable v13 dictionary is system/surfaceFeaturesDict.

extractionMethod     extractFromSurface;

extractFromSurfaceCoeffs
{
    includedAngle    150;
    geometricTestOnly no;
}

subsetFeatures
{
    nonManifoldEdges yes;
    openEdges        yes;
}

trimFeatures
{
    minElem          5;
    minLen           0;
}

writeObj             yes;

